    "Gives Mileager precise coordinates so it can detect movement, save trip start and end points, estimate distance, and continue recording in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt Mileager präzise Koordinaten, um Bewegung zu erkennen, Start- und Endpunkte von Fahrten zu sichern, die Strecke zu schätzen und die Aufzeichnung im Hintergrund fortzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le da a Mileager coordenadas precisas para que pueda detectar movimiento, guardar los puntos de inicio y fin del viaje, estimar la distancia y seguir grabando en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne à Mileager des coordonnées précises pour détecter le mouvement, enregistrer les points de départ et d'arrivée des trajets, estimer la distance et poursuivre l'enregistrement en arrière-plan."
          }
        }
      }
    },
    "Go Back" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück"
          }
        },
