    "IRS business rates could not be verified. Your saved rates are unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IRS business rates could not be verified. Your saved rates are unchanged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die IRS-Sätze für Geschäftsfahrten konnten nicht bestätigt werden. Deine gespeicherten Sätze bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron verificar las tarifas del IRS para negocios. Tus tarifas guardadas no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux IRS professionnels n’ont pas pu être vérifiés. Vos taux enregistrés restent inchangés."
          }
        }
      }
    },
    "IRS rates overlap your custom rates. Review the update before applying it.": {
