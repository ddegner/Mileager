    "Mileager can't reach your trips right now. Unlock your iPhone or iPad and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager kann gerade nicht auf Ihre Fahrten zugreifen. Entsperren Sie Ihr iPhone oder iPad und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager no puede acceder a tus viajes en este momento. Desbloquea tu iPhone o iPad e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager ne peut pas accéder à vos trajets pour le moment. Déverrouillez votre iPhone ou iPad et réessayez."
          }
        }
      }
    },
    "Mileager cannot request this again from inside the app. You can change %@ access in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager kann diese Berechtigung nicht erneut in der App anfordern. Sie können den Zugriff auf %@ in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager no puede volver a solicitar esto desde la app. Puedes cambiar el acceso a %@ en Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager ne peut pas redemander cette autorisation depuis l'app. Vous pouvez modifier l'accès %@ dans Réglages."
          }
        }
      }
    },
    "Mileager couldn't read your trips right now. Open the app and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager konnte Ihre Fahrten gerade nicht lesen. Öffnen Sie die App und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager no pudo leer tus viajes en este momento. Abre la app e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager n’a pas pu lire vos trajets pour le moment. Ouvrez l’app et réessayez."
          }
        }
      }
    },
    "Mileager couldn't save that fee. Open the app and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager konnte diese Gebühr nicht speichern. Öffnen Sie die App und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager no pudo guardar ese gasto. Abre la app e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager n’a pas pu enregistrer ces frais. Ouvrez l’app et réessayez."
          }
        }
      }
    },
    "Mileager doesn't have any completed drives yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager hat noch keine abgeschlossenen Fahrten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager aún no tiene viajes completados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager n’a encore aucun trajet terminé."
          }
        }
      }
    },
    "Mileager doesn't have a current drive to update right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager hat derzeit keine aktuelle Fahrt, die aktualisiert werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager no tiene ningún viaje actual que se pueda actualizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager n’a aucun trajet en cours à mettre à jour pour le moment."
          }
        }
      }
    },
    "Mileager found more than one saved car connection during this trip." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager hat während dieser Fahrt mehr als eine gespeicherte Autoverbindung erkannt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager encontró más de una conexión de coche guardada durante este viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager a détecté plusieurs connexions au véhicule enregistrées pendant ce trajet."
          }
        }
      }
    },
    "Mileager on your Mac shows and reports the trips your iPhone or iPad records. Turn on iCloud Sync to see them here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager auf dem Mac zeigt die Fahrten an, die Ihr iPhone oder iPad aufzeichnet, und erstellt Berichte daraus. Aktivieren Sie die iCloud-Synchronisierung, um sie hier zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager en tu Mac muestra y genera informes de los viajes que registra tu iPhone o iPad. Activa la sincronización con iCloud para verlos aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre Mac, Mileager affiche les trajets enregistrés par votre iPhone ou iPad et en crée des rapports. Activez la synchronisation iCloud pour les voir ici."
          }
        }
      }
    },
    "Mileager saves this reading to your vehicle and uses occasional readings to estimate total vehicle miles and business-use percentage on reports. You can update it anytime in Settings → Vehicles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager speichert diesen Stand bei Ihrem Fahrzeug und nutzt gelegentliche Ablesungen, um die Gesamtkilometer des Fahrzeugs und den geschäftlichen Nutzungsanteil in Berichten zu schätzen. Sie können ihn jederzeit unter Einstellungen → Fahrzeuge aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager guarda esta lectura en tu vehículo y usa lecturas ocasionales para estimar los kilómetros totales del vehículo y el porcentaje de uso profesional en los informes. Puedes actualizarla cuando quieras en Configuración → Vehículos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager enregistre ce relevé sur votre véhicule et utilise des relevés occasionnels pour estimer le kilométrage total du véhicule et le pourcentage d’usage professionnel dans les rapports. Vous pouvez le mettre à jour à tout moment dans Réglages → Véhicules."
          }
        }
      }
    },
    "Mileager will load your trips automatically after this device is unlocked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager lädt Ihre Fahrten automatisch, sobald dieses Gerät entsperrt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager cargará tus viajes automáticamente cuando se desbloquee este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager chargera automatiquement vos trajets une fois cet appareil déverrouillé."
          }
        }
      }
    },
    "Mileager will recognize this car automatically on future drives." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager erkennt dieses Auto bei zukünftigen Fahrten automatisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager reconocerá este coche automáticamente en futuros viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager reconnaîtra automatiquement cette voiture lors des prochains trajets."
          }
        }
      }
    },
    "Mileager will stop using this connection to help detect drives. You can restore it later in Settings › Vehicles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager verwendet diese Verbindung nicht mehr zur Fahrterkennung. Sie können sie später unter Einstellungen › Fahrzeuge wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager dejará de usar esta conexión para detectar viajes. Puedes restaurarla más tarde en Ajustes › Vehículos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager cessera d’utiliser cette connexion pour détecter les trajets. Vous pourrez la restaurer plus tard dans Réglages › Véhicules."
          }
        }
      }
    },
    "Mileager will suggest %@ next time, but still ask you to confirm." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager schlägt beim nächsten Mal %@ vor, bittet Sie aber weiterhin um Bestätigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
