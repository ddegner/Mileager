    "Before combining, Mileager saves a recovery copy of this device's mileage data on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Zusammenführen speichert Mileager auf diesem Gerät eine Wiederherstellungskopie der Kilometerdaten dieses Geräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de combinar, Mileager guarda en este dispositivo una copia de recuperación de los datos de kilometraje de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant la fusion, Mileager enregistre sur cet appareil une copie de récupération des données kilométriques de cet appareil."
          }
        }
      }
    },
