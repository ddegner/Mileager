    "Vehicles saved here will also be combined with vehicles already in iCloud. Similar names stay separate; Mileager does not merge them automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier gespeicherte Fahrzeuge werden ebenfalls mit den bereits in iCloud vorhandenen Fahrzeugen kombiniert. Ähnliche Namen bleiben getrennt; Mileager führt sie nicht automatisch zusammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los vehículos guardados aquí también se combinarán con los vehículos que ya están en iCloud. Los nombres similares permanecerán separados; Mileager no los fusiona automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les véhicules enregistrés ici seront également combinés avec ceux déjà présents dans iCloud. Les noms similaires restent séparés ; Mileager ne les fusionne pas automatiquement."
          }
        }
      }
