    },
    "Sync is ready. Quit and reopen Mileager to start downloading your trips." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung ist bereit. Beenden und öffnen Sie Mileager erneut, um mit dem Laden Ihrer Fahrten zu beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización está lista. Sal de Mileager y vuelve a abrirlo para empezar a descargar tus viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation est prête. Quittez puis rouvrez Mileager pour commencer à télécharger vos trajets."
          }
        }
      }
    },
    "Sync starts after you close and reopen Mileager. Drive capture continues to work without an internet connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung beginnt, nachdem Sie Mileager geschlossen und erneut geöffnet haben. Die Fahrterfassung funktioniert weiterhin ohne Internetverbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización comienza después de cerrar y volver a abrir Mileager. El registro de viajes sigue funcionando sin conexión a internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation commence après avoir fermé puis rouvert Mileager. L’enregistrement des trajets continue de fonctionner sans connexion internet."
          }
        }
      }
    },
    "Sync starts after you quit and reopen Mileager." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung beginnt, nachdem Sie Mileager beendet und erneut geöffnet haben."
