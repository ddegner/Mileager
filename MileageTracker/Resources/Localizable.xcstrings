    "You drove %@ for business in %@ across %@. Mileage reimbursement: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im %2$@ sind Sie %1$@ geschäftlich gefahren, verteilt auf %3$@. Kilometererstattung: %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %2$@ condujiste %1$@ por trabajo en %3$@. Reembolso por kilometraje: %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %2$@, vous avez parcouru %1$@ à titre professionnel sur %3$@. Remboursement kilométrique : %4$@."
          }
        }
      }
    },
    "You're all caught up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist auf dem neuesten Stand."
          }
        },
