        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización comienza después de salir de Mileager y volver a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation commence après avoir quitté puis rouvert Mileager."
          }
        }
