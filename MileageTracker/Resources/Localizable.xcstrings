    "There are no trips to export." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind keine Fahrten zum Exportieren vorhanden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay viajes para exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
