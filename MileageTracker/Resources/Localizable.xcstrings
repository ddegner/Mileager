    },
    "The Drive I'm On" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Fahrt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El viaje en curso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trajet en cours"
          }
        }
      }
    },
    "The first purpose is the default for new business trips. Drag to reorder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Zweck ist der Standard für neue Geschäftsfahrten. Zum Neuordnen ziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer propósito es el predeterminado para nuevos viajes de trabajo. Arrastra para reordenar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier motif est celui par défaut pour les nouveaux trajets professionnels. Faites glisser pour réorganiser."
          }
        }
      }
    },
    "The GPS location jumped unexpectedly — check the distance and route." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die GPS-Position ist unerwartet gesprungen – überprüfen Sie Strecke und Route."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación GPS saltó de forma inesperada; revisa la distancia y la ruta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position GPS a fait un saut inattendu — vérifiez la distance et l'itinéraire."
          }
        }
      }
    },
    "There are no business trips with a purpose to export for this period and vehicle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Zeitraum und dieses Fahrzeug gibt es keine Geschäftsfahrten mit einem Zweck zum Exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay viajes de negocios con un propósito para exportar en este período y vehículo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun trajet professionnel avec un motif à exporter pour cette période et ce véhicule."
          }
        }
      }
    },
    "The report could not be generated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bericht konnte nicht erstellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo generar el informe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport n’a pas pu être généré."
          }
        }
      }
    },
    "The selected vehicle applies to the entire current drive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Fahrzeug gilt für die gesamte aktuelle Fahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vehículo seleccionado se aplica a todo el viaje actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le véhicule sélectionné s’applique à l’ensemble du trajet en cours."
          }
        }
      }
    },
