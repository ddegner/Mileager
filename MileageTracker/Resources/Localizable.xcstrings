    "Trips already in iCloud will be downloaded to this device. Nothing in iCloud will be replaced." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits in iCloud vorhandene Fahrten werden auf dieses Gerät geladen. Nichts in iCloud wird ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los viajes que ya están en iCloud se descargarán en este dispositivo. No se reemplazará nada de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trajets déjà présents dans iCloud seront téléchargés sur cet appareil. Aucun élément dans iCloud ne sera remplacé."
          }
        }
      }
    },
    "Trips already in iCloud will be downloaded to this Mac. Nothing in iCloud will be replaced." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits in iCloud vorhandene Fahrten werden auf diesen Mac geladen. Nichts in iCloud wird ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
