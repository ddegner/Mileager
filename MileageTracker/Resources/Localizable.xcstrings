    "More than one of your cars was nearby at the start — check which vehicle this trip belongs to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Start war mehr als eines Ihrer Autos in der Nähe – prüfen Sie, zu welchem Fahrzeug diese Fahrt gehört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
