    "Bluetooth helps Mileager recognize your car and improve automatic trip starts. Movement is still required." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth hilft Mileager, Ihr Auto zu erkennen und automatische Fahrtstarts zu verbessern. Bewegung ist weiterhin erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth ayuda a Mileager a reconocer tu coche y mejorar el inicio automático de los viajes. El movimiento sigue siendo necesario."
