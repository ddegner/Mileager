    "The IRS update overlaps custom rates. Choose which rates to use for the dates shown.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The IRS update overlaps custom rates. Choose which rates to use for the dates shown."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die IRS-Aktualisierung überschneidet sich mit eigenen Sätzen. Wähle die Sätze für die angezeigten Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización del IRS coincide con tarifas personalizadas. Elige qué tarifas usar para las fechas indicadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour de l’IRS recouvre des taux personnalisés. Choisissez les taux à utiliser pour les dates indiquées."
          }
        }
