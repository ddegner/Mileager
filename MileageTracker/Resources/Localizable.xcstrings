    "This permanently deletes %lld selected trips. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden %lld ausgewählte Fahrten dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente %lld viajes seleccionados. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement %lld trajets sélectionnés. Elle est irréversible."
          }
        }
      }
    },
    "This permanently deletes the selected trip. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die ausgewählte Fahrt dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente el viaje seleccionado. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement le trajet sélectionné. Elle est irréversible."
          }
        }
      }
    },
    "This permanently deletes this trip and its mileage. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Fahrt und ihre Kilometer werden dauerhaft gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente este viaje y su kilometraje. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement ce trajet et son kilométrage. Cette action est irréversible."
          }
        }
      }
    },
    "This permanently deletes your %@ trip. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird Ihre Fahrt vom %@ dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente tu viaje del %@. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement votre trajet du %@. Elle est irréversible."
          }
        }
      }
    },
    "This removes the saved connection between %@ and this vehicle. Mileager can ask you to assign it again when the connection is detected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die gespeicherte Verbindung zwischen %@ und diesem Fahrzeug entfernt. Mileager kann Sie erneut nach der Zuordnung fragen, wenn die Verbindung erkannt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina la conexión guardada entre %@ y este vehículo. Mileager puede pedirte que la asignes de nuevo cuando detecte la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime la connexion enregistrée entre %@ et ce véhicule. Mileager pourra vous demander de l’attribuer à nouveau lorsque la connexion sera détectée."
          }
        }
      }
    },
