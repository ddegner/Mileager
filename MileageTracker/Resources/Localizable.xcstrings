    "Automatic tracking is limited" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische Erfassung ist eingeschränkt"
          }
        },
        "es" : {
          "stringUnit" : {
