    "Calculated values for existing trips from these dates will update. Saved PDFs do not change.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated values for existing trips from these dates will update. Saved PDFs do not change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die berechneten Werte vorhandener Fahrten ab diesen Daten werden aktualisiert. Gespeicherte PDFs bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se actualizarán los importes calculados de los viajes existentes a partir de estas fechas. Los PDF guardados no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les montants calculés des trajets existants à partir de ces dates seront mis à jour. Les PDF enregistrés ne changent pas."
          }
        }
