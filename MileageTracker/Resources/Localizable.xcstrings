          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mileager suggérera %@ la prochaine fois, mais vous demandera toujours confirmation."
          }
        }
      }
    },
    "Mileager will suggest this car on future drives, but still ask you to confirm." : {
      "localizations" : {
