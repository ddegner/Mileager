    "Existing rates and fees keep their numbers when you change currency. They are not converted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Währungswechsel bleiben die Zahlenwerte bestehender Sätze und Gebühren unverändert. Sie werden nicht umgerechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarifas y los gastos existentes conservan sus valores al cambiar de moneda. No se convierten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux et frais existants conservent leurs valeurs lorsque vous changez de devise. Ils ne sont pas convertis."
          }
        }
      }
    },
    "Mileage rate not set. This export uses a zero mileage value.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kilometersatz festgelegt. Dieser Export verwendet einen Fahrtkostenwert von null."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha establecido una tarifa de kilometraje. Esta exportación usa un importe de kilometraje de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun taux kilométrique défini. Cet export utilise une valeur kilométrique nulle."
          }
        }
      }
    },
    "This rate changed. Reopen the editor and try again.": {
      "extractionState": "manual",
      "localizations": {
