    "Lower than your last reading (%@ %@ on %@). Check for a typo — it will still save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedriger als Ihr letzter Stand (%1$@ %2$@ am %3$@). Prüfen Sie auf einen Tippfehler – gesichert wird trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower than your last reading (%1$@ %2$@ on %3$@). Check for a typo — it will still save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es menor que tu última lectura (%1$@ %2$@ del %3$@). Revisa que no sea un error de escritura; se guardará de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inférieur à votre dernier relevé (%1$@ %2$@ le %3$@). Vérifiez qu'il n'y a pas d'erreur de saisie — la valeur sera quand même enregistrée."
          }
        }
      }
    },
