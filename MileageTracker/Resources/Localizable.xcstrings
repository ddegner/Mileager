{
  "sourceLanguage" : "en",
  "strings" : {
    "Using CarPlay? Choose CarPlay and Connects, then set the Check for Drive action's Trigger to CarPlay.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit CarPlay? Wähle CarPlay und „Wird verbunden“ und setze den Auslöser der Aktion „Nach Fahrt suchen“ auf CarPlay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Usas CarPlay? Elige CarPlay y Al conectar, y selecciona CarPlay como Activador en Comprobar si hay un viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous utilisez CarPlay ? Choisissez CarPlay et Se connecte, puis CarPlay comme Déclencheur dans Rechercher un trajet."
          }
        }
      }
    },
    "Add Mileager's Check for Drive action, set Trigger to Vehicle Bluetooth, then tap Done.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Mileagers Aktion „Nach Fahrt suchen“ hinzu, setze den Auslöser auf Fahrzeug-Bluetooth und tippe auf Fertig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la acción Comprobar si hay un viaje de Mileager, selecciona Bluetooth del vehículo como Activador y toca OK."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l’action Rechercher un trajet de Mileager, choisissez Bluetooth du véhicule comme Déclencheur, puis touchez OK."
          }
        }
      }
    },
