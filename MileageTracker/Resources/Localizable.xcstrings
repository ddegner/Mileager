        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trajets déjà présents dans iCloud seront téléchargés sur ce Mac. Aucun élément dans iCloud ne sera remplacé."
          }
        }
      }
    },
    "Trips and files you already exported are not affected. Reports can be generated again from Months." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits exportierte Fahrten und Dateien sind nicht betroffen. Berichte können unter „Monate“ erneut erstellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los viajes y archivos ya exportados no se verán afectados. Los informes se pueden volver a generar desde Meses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trajets et fichiers déjà exportés ne sont pas affectés. Les rapports peuvent être générés à nouveau depuis Mois."
          }
        }
      }
    },
    "Trips assigned to %@ will remain and will appear under %@, your default vehicle. %@’s odometer history and saved CarPlay and Bluetooth connections will be deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahrten, die %@ zugewiesen sind, bleiben erhalten und werden unter %@, Ihrem Standardfahrzeug, angezeigt. Der Kilometerstandverlauf und die gespeicherten CarPlay- und Bluetooth-Verbindungen von %@ werden gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los viajes asignados a %@ se conservarán y aparecerán en %@, tu vehículo predeterminado. Se eliminarán el historial del cuentakilómetros y las conexiones de CarPlay y Bluetooth guardadas de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trajets attribués à %@ seront conservés et apparaîtront sous %@, votre véhicule par défaut. L’historique du compteur et les connexions CarPlay et Bluetooth enregistrées de %@ seront supprimés."
          }
        }
      }
    },
    "Trips assigned to %@ will remain and will appear under your default vehicle. %@’s odometer history and saved CarPlay and Bluetooth connections will be deleted." : {
      "localizations" : {
